# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Provide your Supabase project URL and anon public key to connect live database & Auth.
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# OPENALEX CONFIGURATION:
# Provide your OpenAlex API key to connect live scholarly literature search & metadata.
OPENALEX_API_KEY="your-openalex-api-key"
OPENALEX_BASE_URL="https://api.openalex.org"
